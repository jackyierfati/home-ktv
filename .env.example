# 复制成 .env 再改：cp .env.example .env

# 歌曲文件存哪：下好的 MKV 都在这里，一首 50~80 MB，空间留大一点
KTV_MEDIA=./media
# 曲库、设置、已点和下载队列（几十 MB）
KTV_DATA=./data
# 手机点歌、电视、管理页都用这个端口：http://<这台机器的 IP>:8787
KTV_PORT=8787
# 电视主页和点歌页上的名字，之后也可以在管理页改
KTV_NAME=家庭KTV

# 每首歌同时开几路下载、同时下几首。网络差（比如在海外）时多开几路反而更快
KTV_THREADS=64
KTV_PARALLEL=2

# ---------- 在国外？ ----------
# 歌源在国内，海外直连常常很慢或者取不到下载地址，下载走中国大陆出口会快很多、稳很多。
#
# 方法一：已经有中国大陆出口的 HTTP 代理，直接填：
# KTV_PROXY=http://192.168.1.20:8888
#
# 方法二：用 WireGuard（任何有中国大陆节点、能导出 WireGuard 配置的 VPN 都行），
# 把配置里的值填到下面，私钥单独放到 secrets/wireguard_private_key 文件里，然后
#   docker compose --profile vpn up -d
# KTV_PROXY=http://vpn:8888
# WIREGUARD_ENDPOINT_IP=
# WIREGUARD_ENDPOINT_PORT=51820
# WIREGUARD_PUBLIC_KEY=
# WIREGUARD_ADDRESSES=10.2.0.2/32
