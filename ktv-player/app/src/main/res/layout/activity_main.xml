<?xml version="1.0" encoding="utf-8"?>
<!-- 视频在最底下；上面盖一层透明 WebView，主页、正在播放和已点列表都由 NAS 上的 /tv 页面画，改界面不用重装 App。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <!-- WebView 在代码里建，渲染进程崩了可以原地换一个，不打断正在放的歌 -->
    <FrameLayout
        android:id="@+id/webHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 主页打不开（NAS 连不上）时 -->
    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/idle_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:letterSpacing="0.15"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="[J]@cK-Y"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="家庭KTV"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:textColor="#D0C8EA"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 按键后的即时提示 -->
    <TextView
        android:id="@+id/notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_bg"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:visibility="gone" />
</FrameLayout>
